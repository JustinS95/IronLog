{
  "name": "ironlog",
  "private": true,
  "version": "0.1.0",
  "description": "Combat upgrade tracker for RuneScape ironman players, in PVME's upgrade order.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "data": "node scripts/build-data.ts",
    "predev": "npm run data",
    "dev": "vite",
    "prebuild": "npm run data",
    "build": "vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run data",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "npm run data",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.4"
  }
}
